{
  "author": "Subhan Malik",
  "bin": {
    "dns-lookup": "dist/src/cli.js"
  },
  "description": "DNS lookup CLI in TypeScript: hand-rolled DNS wire protocol over UDP, TTL-aware caching, A/AAAA/CNAME/MX/NS/TXT/PTR support",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.6"
  },
  "keywords": [
    "dns",
    "dns-lookup",
    "udp",
    "wire-protocol",
    "cli"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "name": "typescript-dns-lookup",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/cli.js",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "version": "1.0.0"
}